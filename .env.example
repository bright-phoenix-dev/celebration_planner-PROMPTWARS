# Google Gemini API Key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Name (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Rate limit: max requests per minute per IP (default: 10)
RATE_LIMIT_MAX=10

# Global rate limit: max requests per minute per serverless instance (default: 30)
RATE_LIMIT_GLOBAL_MAX=30
